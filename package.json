{
    "name": "revenue-assistant-userscript",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "scripts": {
        "build": "vite build --config ./vite.userscript.config.mjs --mode userscript",
        "build:legacy": "node ./scripts/build.mjs",
        "dev": "node ./scripts/build.mjs --watch",
        "dev:fixture": "vite --config ./vite.fixture.config.mjs",
        "build:vite:fixture": "vite build --config ./vite.fixture.config.mjs",
        "build:vite:candidate": "vite build --config ./vite.userscript.config.mjs --mode candidate",
        "build:next:candidate": "vite build --config ./vite.next-userscript.config.mjs --mode candidate",
        "build:next:publication": "vite build --config ./vite.next-userscript.config.mjs --mode publication",
        "dev:next:fixture": "vite --config ./vite.next-fixture.config.mjs",
        "build:next:fixture": "vite build --config ./vite.next-fixture.config.mjs",
        "build:compare:vite": "node ./scripts/compare-vite-build.mjs",
        "check:next:artifact": "node ./scripts/check-next-userscript-artifact.mjs",
        "check:next:publication-artifact": "node ./scripts/check-next-publication-artifact.mjs",
        "check:next:publication-boundary": "node ./scripts/check-next-publication-boundary.mjs",
        "check:next:publication": "node ./scripts/check-next-publication-contract.mjs",
        "check:classic-publication": "node ./scripts/check-classic-publication-boundary.mjs",
        "check:next:runtime": "node ./scripts/check-next-runtime-lease.mjs",
        "check:next:performance": "node ./scripts/check-next-performance-recorder.mjs",
        "check:next:calendar-summary": "node ./scripts/check-next-calendar-summary.mjs",
        "check:next:rank-learning": "node ./scripts/check-next-rank-learning.mjs",
        "check:next:live-shell": "node ./scripts/check-next-live-shell.mjs",
        "check:next:live-performance-runtime": "node ./scripts/check-next-live-performance-runtime.mjs",
        "check:next:analyze-parity": "node ./scripts/check-next-analyze-parity.mjs",
        "check:next:analyze-competitor": "node ./scripts/check-next-analyze-competitor.mjs",
        "check:next:analyze-booking-curve": "node ./scripts/check-next-analyze-booking-curve.mjs",
        "check:next:analyze-sales-setting": "node ./scripts/check-next-analyze-sales-setting.mjs",
        "check:next:analyze-sales-setting-runtime": "node ./scripts/check-next-analyze-sales-setting-runtime.mjs",
        "check:next:booking-curve-acquisition": "node ./scripts/check-next-booking-curve-acquisition.mjs",
        "check:next:analyze-price-trend": "node ./scripts/check-next-analyze-price-trend.mjs",
        "check:next:monthly-progress": "node ./scripts/check-next-monthly-progress.mjs",
        "check:next:live-evidence": "node ./scripts/check-next-live-evidence.mjs",
        "check:next:data-source": "node ./scripts/check-next-data-source.mjs",
        "check:next:read-boundary": "node ./scripts/check-next-read-boundary.mjs",
        "check:next:similarity": "node ./scripts/check-next-similarity-model.mjs",
        "check:next": "npm run typecheck && npm run lint && npm run check:next:runtime && npm run check:next:performance && npm run check:next:calendar-summary && npm run check:next:rank-learning && npm run check:next:live-shell && npm run check:next:live-performance-runtime && npm run check:next:analyze-parity && npm run check:next:analyze-competitor && npm run check:next:analyze-booking-curve && npm run check:next:analyze-sales-setting && npm run check:next:analyze-sales-setting-runtime && npm run check:next:booking-curve-acquisition && npm run check:next:analyze-price-trend && npm run check:next:monthly-progress && npm run check:next:similarity && npm run check:next:live-evidence && npm run check:next:data-source && npm run check:next:read-boundary && npm run check:next:publication && npm run build:next:fixture",
        "collect:next-performance": "node ./scripts/collect-next-performance.mjs",
        "collect:next-performance:live": "node ./scripts/collect-next-performance-live.mjs",
        "check:fixture-markers": "node ./scripts/check-rank-fixture-markers.mjs",
        "check:request-scheduler": "node ./scripts/check-request-scheduler.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "check": "npm run typecheck && npm run lint && npm run build",
        "react:doctor": "react-doctor --yes --no-score --blocking none",
        "chrome:debug": "pwsh -ExecutionPolicy Bypass -File ./scripts/open-chrome-debug.ps1",
        "chrome:debug:default-profile": "pwsh -ExecutionPolicy Bypass -File ./scripts/open-chrome-debug.ps1 -UseChromeUserData -ProfileDirectory Default",
        "chrome:debug:default-profile:resume": "pwsh -ExecutionPolicy Bypass -File ./scripts/open-chrome-debug.ps1 -UseChromeUserData -ProfileDirectory Default -RestoreLastSession",
        "chrome:profiles": "pwsh -ExecutionPolicy Bypass -File ./scripts/list-chrome-profiles.ps1",
        "chrome:pages": "node ./scripts/attach-chrome.mjs",
        "userscript:version-check": "node ./scripts/check-userscript-version.mjs",
        "smoke:write-posts": "node ./scripts/monitor-write-api-posts.mjs",
        "smoke:distribution": "node ./scripts/run-distribution-smoke.mjs",
        "check:distribution-smoke-fixture": "node ./scripts/run-distribution-smoke.mjs --self-test",
        "check:booking-curve-smoke-fixture": "node ./scripts/check-booking-curve-smoke-fixture.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/tampermonkey": "5.0.5",
        "@vitejs/plugin-react": "6.0.5",
        "esbuild": "0.28.2",
        "eslint": "10.8.1",
        "globals": "17.11.0",
        "playwright-core": "1.62.1",
        "react-doctor": "0.9.12",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.1"
    },
    "dependencies": {
        "@radix-ui/react-popover": "1.1.23",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    }
}
